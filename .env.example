# Copiar a .env.local y llenar. NUNCA subir .env.local al repositorio.
#
# De dónde sale cada valor:
#   [tú]     lo generas con: openssl rand -base64 33   (uno distinto por variable)
#   [panel]  lo copias del panel del servicio

# Neon → botón Connect → Pooled connection                                [panel]
DATABASE_URL=

# Firma y cifra la cookie de sesión. Debe ser el MISMO en local y en
# Vercel: si cambia, se cierran todas las sesiones abiertas.            [tú]
AUTH_SECRET=

# Google Cloud → Credenciales → ID de cliente de OAuth (Aplicación web) [panel]
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# A quién le llegan los códigos de acceso de los familiares.
OWNER_EMAIL=danielsanmarquez84@gmail.com

# Resend → API Keys (permiso Sending access)                            [panel]
RESEND_API_KEY=

# Firma los enlaces Aprobar/Rechazar del correo del OTP.
# Distinto de AUTH_SECRET.                                              [tú]
ACCESS_DECISION_SECRET=

# Cloudflare Turnstile (opcional, Fase 3)                               [panel]
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
